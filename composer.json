{
    "name": "splicewire/laravel-beam-docs",
    "description": "Optional Beam OpenAPI documentation and Scalar publication.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "rushing/laravel-data-schemas-scribe": "dev-main",
        "splicewire/laravel-beam": "dev-main",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/yaml": "^6.0|^7.0|^8.0",
        "symfony/process": "^6.0|^7.0|^8.0",
        "splicewire/laravel-beam-ux": "dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "rushing/laravel-surgeon": "*",
        "rushing/php-package-topology": "dev-main",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Docs\\": "src/",
            "Splicewire\\Beam\\Scribe\\": "legacy/Scribe/",
            "Splicewire\\Beam\\OpenApi\\": "legacy/OpenApi/"
        },
        "classmap": [
            "legacy/Http/",
            "legacy/Doctor/",
            "legacy/Surgeon/",
            "legacy/Surface/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Docs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Docs\\BeamDocsServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/codegen.git"
        },
